# Kafka (env_prefix: KAFKA_)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=my-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest  # earliest | latest | none
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=60000

# Secure Kafka connection options (optional; leave blank for plaintext local dev)
# KAFKA_SECURITY_PROTOCOL=SASL_SSL  # PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
# KAFKA_SASL_MECHANISMS=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=/etc/pyrallel/kafka/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/etc/pyrallel/kafka/client.crt
# KAFKA_SSL_KEY_LOCATION=/etc/pyrallel/kafka/client.key
# KAFKA_SSL_KEY_PASSWORD=

# Parallel Consumer (env_prefix: PARALLEL_CONSUMER_)
PARALLEL_CONSUMER_POLL_BATCH_SIZE=1000
PARALLEL_CONSUMER_WORKER_POOL_SIZE=8
PARALLEL_CONSUMER_ORDERING_MODE=key_hash  # key_hash | partition | unordered
PARALLEL_CONSUMER_QUEUE_MAX_MESSAGES=5000
PARALLEL_CONSUMER_MESSAGE_CACHE_MAX_BYTES=67108864
PARALLEL_CONSUMER_DIAG_LOG_EVERY=1000
PARALLEL_CONSUMER_BLOCKING_WARN_SECONDS=5.0
PARALLEL_CONSUMER_MAX_BLOCKING_DURATION_MS=0
PARALLEL_CONSUMER_BLOCKING_CACHE_TTL=100
PARALLEL_CONSUMER_STRICT_COMPLETION_MONITOR_ENABLED=true
PARALLEL_CONSUMER_COMMIT_DEBOUNCE_COMPLETION_THRESHOLD=100
PARALLEL_CONSUMER_COMMIT_DEBOUNCE_INTERVAL_MS=100
PARALLEL_CONSUMER_REBALANCE_STATE_STRATEGY=contiguous_only  # contiguous_only | metadata_snapshot

# Adaptive backpressure (under PARALLEL_CONSUMER_ prefix)
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__ENABLED=false
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__MIN_IN_FLIGHT=1
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__SCALE_UP_STEP=16
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__SCALE_DOWN_STEP=16
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__COOLDOWN_MS=1000
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__LAG_SCALE_UP_THRESHOLD=0
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__LOW_LATENCY_THRESHOLD_MS=25.0
PARALLEL_CONSUMER_ADAPTIVE_BACKPRESSURE__HIGH_LATENCY_THRESHOLD_MS=100.0

# Adaptive concurrency (under PARALLEL_CONSUMER_ prefix)
PARALLEL_CONSUMER_ADAPTIVE_CONCURRENCY__ENABLED=false
PARALLEL_CONSUMER_ADAPTIVE_CONCURRENCY__MIN_IN_FLIGHT=0
PARALLEL_CONSUMER_ADAPTIVE_CONCURRENCY__SCALE_UP_STEP=32
PARALLEL_CONSUMER_ADAPTIVE_CONCURRENCY__SCALE_DOWN_STEP=64
PARALLEL_CONSUMER_ADAPTIVE_CONCURRENCY__COOLDOWN_MS=1000

# Poison-message circuit breaker (under PARALLEL_CONSUMER_ prefix)
PARALLEL_CONSUMER_POISON_MESSAGE__ENABLED=false
PARALLEL_CONSUMER_POISON_MESSAGE__FAILURE_THRESHOLD=3
PARALLEL_CONSUMER_POISON_MESSAGE__COOLDOWN_MS=30000

# Execution (env_prefix: EXECUTION_)
EXECUTION_MODE=async   # async | process
EXECUTION_MAX_IN_FLIGHT=1000
EXECUTION_ROUTE_BATCH_SIZE=64
EXECUTION_MAX_REVOKE_GRACE_MS=500
EXECUTION_SHUTDOWN_POLICY=graceful  # graceful | abort
EXECUTION_CONSUMER_TASK_STOP_TIMEOUT_MS=5000
EXECUTION_SHUTDOWN_DRAIN_TIMEOUT_MS=5000
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BACKOFF_MS=1000
EXECUTION_EXPONENTIAL_BACKOFF=true
EXECUTION_MAX_RETRY_BACKOFF_MS=30000
EXECUTION_RETRY_JITTER_MS=200

# Async engine
EXECUTION_ASYNC_CONFIG__TASK_TIMEOUT_MS=30000
EXECUTION_ASYNC_CONFIG__SHUTDOWN_GRACE_TIMEOUT_MS=5000

# Process engine (env_prefix: PROCESS_)
PROCESS_PROCESS_COUNT=8
PROCESS_QUEUE_SIZE=2048
PROCESS_REQUIRE_PICKLABLE_WORKER=true
PROCESS_BATCH_SIZE=1
PROCESS_BATCH_BYTES=256KB
PROCESS_TRANSPORT_MODE=worker_pipes  # shared_queue | worker_pipes
PROCESS_MAX_BATCH_WAIT_MS=0
PROCESS_FLUSH_POLICY=size_or_timer  # size_or_timer | demand | demand_min_residence
PROCESS_DEMAND_FLUSH_MIN_RESIDENCE_MS=0
PROCESS_SHUTDOWN_DRAIN_TIMEOUT_MS=5000
PROCESS_WORKER_JOIN_TIMEOUT_MS=30000
PROCESS_TASK_TIMEOUT_MS=30000
PROCESS_MSGPACK_MAX_BYTES=1000000
PROCESS_MAX_TASKS_PER_CHILD=0
PROCESS_RECYCLE_JITTER_MS=0

# Metrics (env_prefix: METRICS_)
METRICS_ENABLED=false
METRICS_PORT=9091

# DLQ (under KAFKA_ prefix)
KAFKA_DLQ_ENABLED=true
KAFKA_DLQ_TOPIC_SUFFIX=.dlq
KAFKA_DLQ_PAYLOAD_MODE=full  # full | metadata_only
KAFKA_DLQ_FLUSH_TIMEOUT_MS=5000

# Grafana (docker-compose)
GF_SECURITY_ADMIN_PASSWORD=
